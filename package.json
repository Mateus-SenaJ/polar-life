{
  "name": "polar-life",
  "version": "0.11.0",
  "private": true,
  "type": "module",
  "description": "Polar Life · editor web local-first de polaroids. Telas T-01 a T-14, T-18 a T-24, T-31 e T-28 a T-30.",
  "scripts": {
    "serve": "npx --yes serve site",
    "verificar": "node tools/verificar.mjs",
    "testar": "node tests/unit/testar-quadro.mjs",
    "testar:lote": "python3 tests/e2e-py/testar-lote.py",
    "testar:formato": "python3 tests/e2e-py/testar-formato.py",
    "testar:prevoo": "python3 tests/e2e-py/testar-prevoo.py",
    "testar:exportar": "python3 tests/e2e-py/testar-exportar.py",
    "testar:gerar": "python3 tests/e2e-py/testar-gerar.py",
    "testar:imprimir": "python3 tests/e2e-py/testar-imprimir.py",
    "testar:compartilhar": "python3 tests/e2e-py/testar-compartilhar.py",
    "testar:conexoes": "python3 tests/e2e-py/testar-conexoes.py",
    "testar:estados": "python3 tests/e2e-py/testar-estados.py",
    "testar:adicionar": "python3 tests/e2e-py/testar-adicionar.py",
    "testar:processando": "python3 tests/e2e-py/testar-processando.py",
    "testar:esqueleto": "python3 tests/e2e-py/testar-esqueleto.py",
    "testar:janela": "python3 tests/e2e-py/testar-janela.py",
    "testar:valores": "python3 tests/e2e-py/testar-valores.py",
    "fontes": "node tools/baixar-fontes.mjs",
    "vendor": "node tools/copiar-vendor.mjs",
    "testar:fontes": "node tests/e2e/testar-fontes.mjs",
    "testar:pdf": "node tests/e2e/testar-pdf.mjs",
    "testar:gerar-real": "node tests/e2e/testar-gerar-real.mjs",
    "testar:node": "node tests/unit/testar-quadro.mjs && node tests/e2e/testar-fontes.mjs && node tests/e2e/testar-pdf.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "fontkit": "^2.0.4",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.10.38",
    "playwright": "^1.65.0",
    "subset-font": "^2.9.0"
  }
}
